# ─────────────────────────────────────────────────
# AL-WID Environment Variables
# Copy this to .env and fill in values
# ─────────────────────────────────────────────────

# MongoDB
MONGO_USER=alwid
MONGO_PASS=change_me_strong_password

# Redis
REDIS_PASS=change_me_redis_password

# JWT
JWT_SECRET=change_this_to_a_random_64char_string
JWT_REFRESH_SECRET=change_this_to_another_random_64char_string

# Cloudinary (get from cloudinary.com dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# URLs
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Telegram channel auto-posting
# Both required, or the feature stays off. Token from @BotFather; the bot must
# be an administrator of the channel with "Post Messages" permission.
# Channel can be @username for a public channel, or the numeric -100... id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Facebook Page auto-posting
# Both required, or the feature stays off. Page id is on the Page's About tab;
# the token must be a PAGE access token (not a user token) carrying
# pages_manage_posts + pages_read_engagement. Exchange the short-lived token for
# a long-lived one, or it expires in about an hour.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Frontend (Next.js) — tells Facebook which Page publishes this domain, so the
# «About this content» panel on a shared article stops answering «Could not find
# a Facebook Page for al-telegraph.com». Optional but strongly recommended;
# pair them with claiming the domain in Meta Business Suite.
NEXT_PUBLIC_FACEBOOK_PAGE_URL=https://www.facebook.com/YourPage
NEXT_PUBLIC_FACEBOOK_PAGE_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=
